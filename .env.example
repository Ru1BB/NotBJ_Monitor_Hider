HOST=127.0.0.1
PORT=9178
AMAP_KEY=replace-with-your-web-js-api-key
AMAP_SECURITY_CODE=replace-with-the-matching-security-code
# Optional routing: a separate Web Service API key, never sent to the browser.
AMAP_WEB_SERVICE_KEY=replace-with-your-web-service-api-key
# Default 1; increase only after confirming the account entitlement (maximum 32).
AMAP_ROUTE_MAX_REGIONS=1
