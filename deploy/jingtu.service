[Unit]
Description=Jingtu camera map
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jingtu
Group=jingtu
WorkingDirectory=/srv/jingtu/current
EnvironmentFile=/etc/jingtu/jingtu.env
# Adjust the Node executable path for the target host (Node.js 20+).
ExecStart=/usr/bin/node /srv/jingtu/current/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
